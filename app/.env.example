# TrackChain Frontend Environment Configuration (tc.v1).

# 1. Local Development (Default)
# Leave unset or point to local FastAPI backend instance
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. Vercel Production Deployment
# Set this to the live backend URL in Vercel project settings
# NEXT_PUBLIC_API_URL=https://trackchain-backend.onrender.com
# Or leave unset on Vercel to allow VERCEL_URL auto-resolution
