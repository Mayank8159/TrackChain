# TrackChain Frontend Environment Configuration

# -----------------------------------------------------------------------------
# 1. Local Development (Default)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_SIMULATOR=true
NEXT_PUBLIC_DEFAULT_TRACK_ID=IR-NDLS-BCT-01

# -----------------------------------------------------------------------------
# 2. Vercel Production Deployment
# -----------------------------------------------------------------------------
# Set NEXT_PUBLIC_API_URL to your Hugging Face Spaces Backend URL:
NEXT_PUBLIC_API_URL=https://priyanshu0-1-trackchain.hf.space
#
# If left unset on Vercel, the frontend auto-resolves to Vercel origin and proxies
# /api/* routes to the backend via Next.js rewrites.
