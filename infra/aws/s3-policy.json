{
  "_comment": "Least-privilege S3 bucket policy for media uploads.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEdgeMediaUpload",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/TrackChainEdgeCarRole"
      },
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::trackchain-media/*"
    }
  ]
}
