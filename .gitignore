# Ignore node_modules, venv, artifacts, data, env files, and OS junk.

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/
*.egg-info/
*.egg

# Turbo
.turbo/

# Python virtualenvs & cache
__pycache__/
*.py[cod]
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Data & ML artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/calibration/*
!artifacts/calibration/.gitkeep
!artifacts/calibration/*.json
artifacts/exports/*
!artifacts/exports/.gitkeep
*.pt
*.onnx
*.tflite
*.engine

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs & Testing
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
.pytest_cache/
*.tsbuildinfo

# Database files (should not be in git)
*.db
