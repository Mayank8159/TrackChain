{
  "name": "itms-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Integrated Track Monitoring System — Ministry of Railways",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
