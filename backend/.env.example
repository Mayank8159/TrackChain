# Backend env template — local dev + Lambda production.

# ---- Local Dev ----
DATABASE_URL=postgresql+psycopg2://trackchain:trackchain_secret@localhost:5432/trackchain
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=trackchain-media
S3_REGION=ap-south-1
API_KEY_SECRET=trackchain-super-secret-key-change-in-production
JWT_SECRET_KEY=trackchain-jwt-secret-key-change-in-production
REQUEST_SIGNING_SECRET=trackchain-request-signing-secret-change-in-production
ENVIRONMENT=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Lambda / Production (set via SAM template Parameters) ----
# DATABASE_URL is injected by CloudFormation from RDS endpoint
# REDIS_URL is injected by CloudFormation from ElastiCache endpoint
# S3_BUCKET_NAME is injected by CloudFormation from S3 MediaBucket ref
# JWT_SECRET_KEY, API_KEY_SECRET, REQUEST_SIGNING_SECRET are CloudFormation NoEcho params
# CORS_ORIGINS is injected from FrontendDomain parameter (Vercel URL)

# Lambda-specific (auto-set by runtime, but override here for local testing)
# AWS_LAMBDA_FUNCTION_NAME=trackchain-api
# API_GATEWAY_BASE_PATH=/Prod
