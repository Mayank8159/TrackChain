# Backend env template: DATABASE_URL, S3 bucket, auth secrets.

# Database (PostgreSQL / TimescaleDB)
DATABASE_URL=postgresql+psycopg2://trackchain:trackchain_secret@localhost:5432/trackchain

# Object Storage (S3 or MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=trackchain-media
S3_REGION=us-east-1

# Core Security
API_KEY_SECRET=trackchain-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Service environment
ENVIRONMENT=development
LOG_LEVEL=INFO
