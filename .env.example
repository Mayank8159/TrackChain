# Template for root environment variables (compose project, ports).

# Project
COMPOSE_PROJECT_NAME=trackchain
ENVIRONMENT=development

# Ports
WEB_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL / TimescaleDB
POSTGRES_USER=trackchain
POSTGRES_PASSWORD=trackchain_secret
POSTGRES_DB=trackchain

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_NAME=trackchain-media
